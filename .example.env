# OmniEvolve 环境变量模板
# 复制为 .env（共享默认值，可入 git）和 .local.env（私密 key，不入 git）
# 优先级: .local.env > .env > 系统环境变量

# ── LLM API Key ──────────────────────────────────
# 用哪个 provider 就填哪个 key（放 .local.env）
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# DEEPSEEK_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"     # 自定义 endpoint

# ── 模型配置（覆盖 omnievolve.toml [models]） ──
# OMNIEVOLVE_MODELS__HEAVY='["gpt-4o"]'
# OMNIEVOLVE_MODELS__LIGHT='["gpt-4o-mini"]'

# ── 进化参数 ─────────────────────────────────────
# OMNIEVOLVE_EVOLUTION__MAX_GENERATIONS=50
# OMNIEVOLVE_EVOLUTION__SELF_EVOLVE_ENABLED=true
