# OmniEvolve API Keys — 仅放密钥，其他设置放 configs/*.toml
# 复制为 .local.env 填入实际 key（不入 git）。加载优先级：
# 显式进程环境 > .local.env > .env > TOML 配置 > 默认值。
# 优先级: .local.env > .env > 系统环境变量

# ── LLM API Key ──────────────────────────────────
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# DEEPSEEK_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ── Embedding API Key（如果用 API 而非本地模型）───
# VOYAGE_API_KEY="..."
